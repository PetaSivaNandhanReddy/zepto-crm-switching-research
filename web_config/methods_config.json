      "status": "verified_in_report",
      "formula": "\\alpha = \\frac{k}{k-1}\\left(1 - \\frac{\\sum \\sigma_i^2}{\\sigma_X^2}\\right)",
      "notes": "Not computable for single-item constructs (PROMO1, FAM1, INERT1) which are bounded accordingly."
    },
    {
      "id": "htmt",
      "badge": "Heterotrait-Monotrait Ratio (HTMT)",
      "purpose": "Discriminant validity assessment",
      "where": "Multi-item construct pairs (complete-case n=46)",
      "status": "verified_in_report",
      "formula": "\\text{HTMT}_{ij} = \\frac{\\frac{1}{K_i K_j} \\sum_{g=1}^{K_i} \\sum_{h=1}^{K_j} r_{ig, jh}}{\\sqrt{\\left(\\frac{2}{K_i(K_i-1)}\\sum \\sum r_{ig,ih}\\right) \\left(\\frac{2}{K_j(K_j-1)}\\sum \\sum r_{jg,jh}\\right)}}",
      "notes": "Evaluated on multi-item scales; values > 0.85 indicate potential discriminant validity concern."
    },
    {
      "id": "centering",
      "badge": "Within-Person Centering (Ipsatization)",
      "purpose": "Acquiescence & response-style sensitivity diagnostic",
      "where": "Robustness check across current-user construct ratings (table21)",
      "status": "verified_in_report",
      "formula": "x'_{ij} = x_{ij} - \\bar{x}_i, \\quad \\text{where } \\bar{x}_i = \\frac{1}{K}\\sum_{k=1}^K x_{ik}",
      "notes": "Subtracts respondent-specific mean across Likert items to eliminate individual response-elevation bias."
    },
    {
      "id": "mwu",
      "badge": "Mann–Whitney U Test",
      "purpose": "Two-sample non-parametric distributional comparison",
      "where": "H9 (shifted n=29 vs not n=22) & H10 (Class A n=28 vs Class C n=30)",
      "status": "verified_in_report",
      "formula": "U = n_1 n_2 + \\frac{n_1(n_1+1)}{2} - R_1",
      "notes": "Used for rank-based group comparisons without normality assumptions."
