{
  "methods": [
    {
      "id": "spearman",
      "badge": "Spearman's ρ + Bootstrap CI",
      "purpose": "Non-parametric rank association & precision estimation",
      "where": "Hypotheses H1–H7 (Current users, n=51)",
      "status": "verified_in_report",
      "formula": "ρ = 1 - \\frac{6 \\sum d_i^2}{n(n^2 - 1)} \\quad \\text{(Computed via rank Pearson correlation to handle ties exact)}",
      "notes": "5,000-replicate non-parametric bootstrap (seed 42) for 95% confidence intervals."
    },
    {
      "id": "holm",
