      "purpose": "Family-wise error rate (FWER) control",
      "where": "H1–H7 simultaneous hypothesis tests",
      "status": "verified_in_report",
      "formula": "p_{\\text{adj},(i)} = \\min\\left(1, \\max_{j \\le i} (m - j + 1) p_{(j)}\\right)",
      "notes": "Strict step-down adjustment controlling false discovery across the primary hypothesis family."
    },
    {
      "id": "ols",
      "badge": "OLS with HC3 Robust Standard Errors",
      "purpose": "Exploratory multi-predictor variance modeling",
      "where": "Model M1 (n=51, k=4) & Model M2 (n=51, k=6)",
      "status": "verified_in_report",
      "formula": "Y_i = \\beta_0 + \\sum \\beta_j X_{ji} + \\epsilon_i, \\quad \\operatorname{Var}(\\hat{\\beta})_{\\text{HC3}} = (X^T X)^{-1} X^T \\operatorname{diag}\\left(\\frac{e_i^2}{(1-h_{ii})^2}\\right) X (X^T X)^{-1}",
      "notes": "Exploratory model; 12.8 cases per predictor; HC3 handles small-sample leverage effects."
